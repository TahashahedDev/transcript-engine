# ── Secrets ──────────────────────────────────────────────────────────────────
# Never commit real credentials. Use .env.example / web/.env.local.example as
# the tracked templates; those must contain placeholders only.
.env
.env.*
!.env.example
web/.env.local
web/.env.*.local
!web/.env.local.example
*.pem
*.key
id_rsa*
credentials.json
service-account*.json

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/
venv/
.venv/
env/
ENV/

# ── Tooling caches ───────────────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ── Node / Next.js ───────────────────────────────────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo
.npm
.eslintcache

# ── Runtime output (generated per job — never source) ─────────────────────────
outputs/
temp/
logs/
*.log

# ── Model caches / large binaries ────────────────────────────────────────────
# Models are downloaded on demand into ~/.cache/transcript_engine by default;
# these patterns guard against a cache ever being redirected into the repo.
# Anchored to repo root (leading /) so it does not also match the
# transcript_engine/models/ *source* package — an unanchored "models/" pattern
# previously matched at any depth and silently excluded that whole package
# from every commit, which is what caused ModuleNotFoundError on a fresh clone.
/models/
*.ckpt
*.pt
*.pth
*.bin
*.onnx
*.safetensors

# ── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
