# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Keep the type stub so VS Code has types before the first build
!/.next/types/
!/.next/types/routes.d.ts
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but keep the template that documents frontend configuration.
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
# next-env.d.ts is committed (with stable content) so VS Code has types before first build
