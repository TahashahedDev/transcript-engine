# HuggingFace token — required for pyannote diarization models
# Get yours at: https://huggingface.co/settings/tokens
# Then accept the model terms at:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
TE_HF_TOKEN=hf_your_token_here

# ── ASR Backend ─────────────────────────────────────────────────────────────
# "parakeet" = NVIDIA NeMo parakeet-tdt-0.6b-v2 (requires CUDA + nemo_toolkit)
# "whisper"  = Faster-Whisper / WhisperX (default, works on CPU/MPS)
TE_ASR_BACKEND=parakeet

# Override the Parakeet model (optional)
# TE_PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v2

# ── API Server ───────────────────────────────────────────────────────────────
# Bind address — use 0.0.0.0 on Vast.ai/cloud instances for remote access
TE_API_HOST=0.0.0.0
TE_API_PORT=9097

# Allow all CORS origins — set to 1 on Vast.ai so browser clients can connect
TE_API_ALLOW_ALL_ORIGINS=1

# ── PostgreSQL (Supabase) — required for cloud features ─────────────────────
# Format: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Get from: Supabase project → Settings → Database → Connection string (Transaction mode)
# TE_DATABASE_URL=postgresql+asyncpg://...

# ── Supabase Auth — required for /api/v2/ endpoints ─────────────────────────
# Get from: Supabase project → Settings → API → JWT Secret
# TE_SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── Cloudflare R2 — required for /api/v2/ endpoints ─────────────────────────
# Get from: Cloudflare dashboard → R2 → Manage R2 API Tokens
# TE_R2_ACCOUNT_ID=your-account-id
# TE_R2_ACCESS_KEY_ID=your-access-key-id
# TE_R2_SECRET_ACCESS_KEY=your-secret-access-key
# TE_R2_BUCKET_NAME=transcript-engine

# ── Startup model warmup ─────────────────────────────────────────────────────
# Pre-load Parakeet + pyannote on startup so the first job doesn't pay cold-start.
# Adds ~30-90s to startup time but eliminates per-job loading delays.
TE_WARM_MODELS=1

# ── Optional pipeline overrides ──────────────────────────────────────────────
# TE_PIPELINE__TRANSCRIPTION__DEVICE=cuda
# TE_PIPELINE__DIARIZATION__MAX_SPEAKERS=6
# TE_LOG_LEVEL=DEBUG
# TE_MODELS_CACHE_DIR=/root/.cache/transcript-engine
