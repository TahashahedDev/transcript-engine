# Transcript Engine — environment configuration
#
#   cp .env.example .env    then set TE_HF_TOKEN
#
# Placeholders only. Never commit a real .env — it is gitignored.
# Relative paths are resolved against the project root, not the working
# directory, so the app behaves the same wherever you launch it from.

# ── Required ─────────────────────────────────────────────────────────────────
# HuggingFace token — required for pyannote speaker diarization.
# Get one at:  https://huggingface.co/settings/tokens
# Then accept the terms on BOTH gated models, or diarization returns 401:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
TE_HF_TOKEN=hf_your_token_here

# ── ASR backend ──────────────────────────────────────────────────────────────
# parakeet = NVIDIA NeMo parakeet-tdt-0.6b-v2. Production path. Needs CUDA and
#            nemo_toolkit (installed by setup_gpu.sh).
# whisper  = Faster-Whisper / WhisperX. Fallback; runs on CPU and Apple Silicon.
# The code default is "whisper" so a machine without CUDA still works; this file
# ships "parakeet" because it is the intended production setting.
TE_ASR_BACKEND=parakeet

# TE_PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v2

# ── API server ───────────────────────────────────────────────────────────────
# 0.0.0.0 so a rented GPU box is reachable from your laptop.
TE_API_HOST=0.0.0.0
TE_API_PORT=9097
TE_FRONTEND_PORT=9098

# CORS. By default any host is allowed, but only on TE_FRONTEND_PORT — that
# keeps a single-box deployment working at whatever IP it gets. Pick ONE:
#   TE_API_ALLOW_ALL_ORIGINS=1                       # any origin (simplest)
#   TE_API_CORS_ORIGINS=https://app.example.com      # explicit allowlist
TE_API_ALLOW_ALL_ORIGINS=1

# Fail a job that stops reporting progress, so the UI recovers instead of
# hanging forever.
# TE_API_STALL_TIMEOUT_MINUTES=45

# Where uploads and results live, and how long results are kept.
# TE_API_TEMP_DIR=temp
# TE_API_OUTPUT_DIR=outputs
# TE_API_OUTPUT_TTL_HOURS=24

# ── Startup model warmup ─────────────────────────────────────────────────────
# Pre-load Parakeet + pyannote at startup so the first job skips cold-start.
# Adds ~30-90s to startup. start.sh sets this on by default.
TE_WARM_MODELS=1

# ── Optional: AI grammar pass ────────────────────────────────────────────────
# Enables the "Standard" (archive) processing mode's grammar correction, via an
# OpenAI-compatible endpoint. Both variables are required — with neither set the
# pass silently does nothing and Standard produces the same output as Quick.
# TE_AI_BASE_URL=http://localhost:11434/v1
# TE_AI_MODEL=llama3.1:8b
# TE_AI_API_KEY=

# ── Optional: pipeline overrides ─────────────────────────────────────────────
# Chunking is sized automatically from free VRAM; set these only to override.
# TE_PIPELINE__PARAKEET__CHUNK_SECONDS=0
# TE_PIPELINE__PARAKEET__OVERLAP_SECONDS=0.5
# TE_PIPELINE__TRANSCRIPTION__DEVICE=cuda
# TE_PIPELINE__DIARIZATION__MAX_SPEAKERS=6
# TE_LOG_LEVEL=DEBUG

# Model cache location. Defaults to ~/.cache/transcript_engine. Worth moving to
# a persistent volume on a rented box so models survive a restart.
# TE_MODELS_CACHE_DIR=/path/to/model-cache

# ── Optional: cloud API (v2) — INCOMPLETE, off by default ────────────────────
# Mounts /api/v2/jobs (PostgreSQL + Cloudflare R2 + Supabase auth). The
# endpoints work, but nothing processes the queue yet: a job created there stays
# "queued" forever. Enable only if you are developing that path.
# TE_ENABLE_CLOUD_API=1
# TE_DATABASE_URL=postgresql+asyncpg://user:password@host:6543/postgres
# TE_SUPABASE_JWT_SECRET=
# TE_R2_ACCOUNT_ID=
# TE_R2_ACCESS_KEY_ID=
# TE_R2_SECRET_ACCESS_KEY=
# TE_R2_BUCKET_NAME=transcript-engine
